@online{zhuIntegrativeSpatialSinglecell2020,
  title = {Integrative {{Spatial Single-cell Analysis}} with {{Graph-based Feature Learning}}},
  author = {Zhu, Junjie and Sabatti, Chiara},
  date = {2020-08-13},
  eprinttype = {bioRxiv},
  eprintclass = {New Results},
  pages = {2020.08.12.248971},
  doi = {10.1101/2020.08.12.248971},
  url = {https://www.biorxiv.org/content/10.1101/2020.08.12.248971v1},
  urldate = {2022-08-16},
  abstract = {We propose GLISS, a strategy to discover spatially-varying genes by integrating two data sources: (1) spatial gene expression data such as image-based fluorescence in situ hybridization techniques, and (2) dissociated whole-transcriptome single-cell RNA-sequencing (scRNA-seq) data. GLISS utilizes a graph-based association measure to select and link genes that are spatially-dependent in both data sources. GLISS can discover new spatial genes and recover cell locations in scRNA-seq data from landmark genes determined from SGE data. GLISS also offers a new dimension reduction technique to cluster the genes, while accounting for the inferred spatial structure of the cells. We demonstrate the utility of GLISS on simulated and real datasets, including datasets on the mouse olfactory bulb and breast cancer biopsies, and two spatial studies of the mammalian liver and intestine.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {readme},
  file = {/home/alpaca/GDrive/Zotero/Zhu_Sabatti_2020_Integrative Spatial Single-cell Analysis with Graph-based Feature Learning.pdf;/home/alpaca/Zotero/storage/7RJE57XP/2020.08.12.248971v1.html}
}

@article{zhuRevealingCoherentCellstate2026,
  title = {Revealing a Coherent Cell-State Landscape across Single-Cell Datasets with {{CONCORD}}},
  author = {Zhu, Qin and Jiang, Zuzhi and Zuckerman, Binyamin and Weinberger, Leor and Thomson, Matt and Gartner, Zev J.},
  date = {2026-01-05},
  journaltitle = {Nature Biotechnology},
  shortjournal = {Nat Biotechnol},
  pages = {1--15},
  publisher = {Nature Publishing Group},
  issn = {1546-1696},
  doi = {10.1038/s41587-025-02950-z},
  url = {https://www.nature.com/articles/s41587-025-02950-z},
  urldate = {2026-01-07},
  abstract = {Revealing the underlying cell-state landscape from single-cell data requires overcoming the critical obstacles of batch integration, denoising and dimensionality reduction. Here we present CONCORD, a unified framework that simultaneously addresses these challenges within a single self-supervised model. At its core, CONCORD implements a probabilistic sampling strategy that corrects batch effects through dataset-aware sampling and enhances biological resolution through hard-negative sampling. Using only a minimalist neural network with a single hidden layer and contrastive learning, CONCORD surpasses state-of-the-art performance without relying on deep architectures, auxiliary losses or external supervision. It seamlessly integrates data across batches, technologies and even species to generate high-resolution cell atlases. The resulting latent representations are denoised and biologically meaningful, capturing gene coexpression programs, revealing detailed lineage trajectories and preserving both local geometric relationships and global topological structures. We demonstrate CONCORD’s broad applicability across diverse datasets, establishing it as a general-purpose framework for learning unified, high-fidelity representations of cellular identity and dynamics.},
  langid = {english},
  keywords = {Data integration,Data mining,Machine learning},
  file = {/home/alpaca/GDrive/Zotero/Zhu et al. - 2026 - Revealing a coherent cell-state landscape across single-cell datasets with CONCORD.pdf}
}

