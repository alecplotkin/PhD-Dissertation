@article{parkBayesianFrameworkInferring2024,
  title = {A {{Bayesian}} Framework for Inferring Dynamic Intercellular Interactions from Time-Series Single-Cell Data},
  author = {Park, Cameron and Mani, Shouvik and Beltran-Velez, Nicolas and Maurer, Katie and Huang, Teddy and Li, Shuqiang and Gohil, Satyen and Livak, Kenneth J. and Knowles, David A. and Wu, Catherine J. and Azizi, Elham},
  date = {2024-10-11},
  journaltitle = {Genome Research},
  shortjournal = {Genome Res},
  volume = {34},
  number = {9},
  eprint = {39237300},
  eprinttype = {pubmed},
  pages = {1384--1396},
  issn = {1549-5469},
  doi = {10.1101/gr.279126.124},
  abstract = {Characterizing cell-cell communication and tracking its variability over time are crucial for understanding the coordination of biological processes mediating normal development, disease progression, and responses to perturbations such as therapies. Existing tools fail to capture time-dependent intercellular interactions and primarily rely on databases compiled from limited contexts. We introduce DIISCO, a Bayesian framework designed to characterize the temporal dynamics of cellular interactions using single-cell RNA-sequencing data from multiple time points. Our method utilizes structured Gaussian process regression to unveil time-resolved interactions among diverse cell types according to their coevolution and incorporates prior knowledge of receptor-ligand complexes. We show the interpretability of DIISCO in simulated data and new data collected from T cells cocultured with lymphoma cells, demonstrating its potential to uncover dynamic cell-cell cross talk.},
  langid = {english},
  pmcid = {PMC11529839},
  keywords = {Bayes Theorem,Cell Communication,Humans,Sequence Analysis RNA,Single-Cell Analysis,T-Lymphocytes}
}

