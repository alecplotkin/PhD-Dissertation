  author = {Blaeschke, Franziska and Chen, Yan Yi and Apathy, Ryan and Daniel, Bence and Chen, Andy Y. and Chen, Peixin Amy and Sandor, Katalin and Zhang, Wenxi and Li, Zhongmei and Mowery, Cody T. and Yamamoto, Tori N. and Nyberg, William A. and To, Angela and Yu, Ruby and Bueno, Raymund and Kim, Min Cheol and Schmidt, Ralf and Goodman, Daniel B. and Feuchtinger, Tobias and Eyquem, Justin and Jimmie Ye, Chun and Carnevale, Julia and Satpathy, Ansuman T. and Shifrut, Eric and Roth, Theodore L. and Marson, Alexander},
  date = {2023-09-14},
  journaltitle = {Cell},
  shortjournal = {Cell},
