@article{althausDynamicsCD8Cell2007,
  title = {Dynamics of {{CD8}}+ {{T Cell Responses}} during {{Acute}} and {{Chronic Lymphocytic Choriomeningitis Virus Infection1}}},
  author = {Althaus, Christian L. and Ganusov, Vitaly V. and De Boer, Rob J.},
  date = {2007-09-01},
  journaltitle = {The Journal of Immunology},
  shortjournal = {The Journal of Immunology},
  volume = {179},
  number = {5},
  pages = {2944--2951},
  issn = {0022-1767},
  doi = {10.4049/jimmunol.179.5.2944},
  url = {https://doi.org/10.4049/jimmunol.179.5.2944},
  urldate = {2025-03-07},
  abstract = {Infection of mice with lymphocytic choriomeningitis virus (LCMV) is frequently used to study the underlying principles of viral infections and immune responses. We fit a mathematical model to recently published data characterizing Ag-specific CD8+ T cell responses during acute (Armstrong) and chronic (clone 13) LCMV infection. This allows us to analyze the differences in the dynamics of CD8+ T cell responses against different types of LCMV infections. For the four CD8+ T cell responses studied, we find that, compared with the responses against acute infection, responses against chronic infection are generally characterized by an earlier peak and a faster contraction phase thereafter. Furthermore, the model allows us to give a new interpretation of the effect of thymectomy on the dynamics of CD8+ T cell responses during chronic LCMV infection: a smaller number of naive precursor cells is sufficient to account for the observed differences in the responses in thymectomized mice. Finally, we compare data characterizing LCMV-specific CD8+ T cell responses from different laboratories. Although the data were derived from the same experimental model, we find quantitative differences that can be solved by introducing a scaling factor. Also, we find kinetic differences that are at least partly due to the infrequent measurements of CD8+ T cells in the different laboratories.},
  file = {/home/alpaca/GDrive/Zotero/Althaus et al. - 2007 - Dynamics of CD8+ T Cell Responses during Acute and Chronic Lymphocytic Choriomeningitis Virus Infect.pdf;/home/alpaca/Zotero/storage/LW9J9892/Dynamics-of-CD8-T-Cell-Responses-during-Acute-and.html}
}

