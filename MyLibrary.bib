@article{deloynesLocalizedFourierAnalysis2022,
  title = {Localized {{Fourier Analysis}} for {{Graph Signal Processing}}},
  author = {family=Loynes, given=Basile, prefix=de, useprefix=true and Navarro, Fabien and Olivier, Baptiste},
  date = {2022-03},
  journaltitle = {Applied and Computational Harmonic Analysis},
  shortjournal = {Applied and Computational Harmonic Analysis},
  volume = {57},
  eprint = {1906.04529},
  eprinttype = {arXiv},
  eprintclass = {eess, math},
  pages = {1--26},
  issn = {10635203},
  doi = {10.1016/j.acha.2021.10.004},
  url = {http://arxiv.org/abs/1906.04529},
  urldate = {2022-08-18},
  abstract = {We propose a new point of view in the study of Fourier analysis on graphs, taking advantage of localization in the Fourier domain. For a signal \$f\$ on vertices of a weighted graph \$\textbackslash mathcal\{G\}\$ with Laplacian matrix \$\textbackslash mathcal\{L\}\$, standard Fourier analysis of \$f\$ relies on the study of functions \$g(\textbackslash mathcal\{L\})f\$ for some filters \$g\$ on \$I\_\textbackslash mathcal\{L\}\$, the smallest interval containing the Laplacian spectrum \$\{\textbackslash mathrm sp\}(\textbackslash mathcal\{L\}) \textbackslash subset I\_\textbackslash mathcal\{L\}\$. We show that for carefully chosen partitions \$I\_\textbackslash mathcal\{L\} = \textbackslash sqcup\_\{1\textbackslash leq k\textbackslash leq K\} I\_k\$ (\$I\_k \textbackslash subset I\_\textbackslash mathcal\{L\}\$), there are many advantages in understanding the collection \$(g(\textbackslash mathcal\{L\}\_\{I\_k\})f)\_\{1\textbackslash leq k\textbackslash leq K\}\$ instead of \$g(\textbackslash mathcal\{L\})f\$ directly, where \$\textbackslash mathcal\{L\}\_I\$ is the projected matrix \$P\_I(\textbackslash mathcal\{L\})\textbackslash mathcal\{L\}\$. First, the partition provides a convenient modelling for the study of theoretical properties of Fourier analysis and allows for new results in graph signal analysis (\textbackslash emph\{e.g.\} noise level estimation, Fourier support approximation). We extend the study of spectral graph wavelets to wavelets localized in the Fourier domain, called LocLets, and we show that well-known frames can be written in terms of LocLets. From a practical perspective, we highlight the interest of the proposed localized Fourier analysis through many experiments that show significant improvements in two different tasks on large graphs, noise level estimation and signal denoising. Moreover, efficient strategies permit to compute sequence \$(g(\textbackslash mathcal\{L\}\_\{I\_k\})f)\_\{1\textbackslash leq k\textbackslash leq K\}\$ with the same time complexity as for the computation of \$g(\textbackslash mathcal\{L\})f\$.},
  keywords = {Electrical Engineering and Systems Science - Signal Processing,Mathematics - Functional Analysis},
  file = {/home/alpaca/GDrive/Zotero/de Loynes et al_2022_Localized Fourier Analysis for Graph Signal Processing.pdf;/home/alpaca/Zotero/storage/RQXZYGNE/1906.html}
}

