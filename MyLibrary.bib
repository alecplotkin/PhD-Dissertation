  urldate = {2022-04-12},
  abstract = {The resilience of a complex interconnected system concerns the size of the macroscopic functioning node clusters after external perturbations based on a random or designed scheme. For a representation of interconnected systems with directional or asymmetrical interactions among constituents, the directed network is a convenient choice. Yet, how the interaction directions affect the network resilience still lacks a thorough exploration. Here, we study the resilience of directed networks with a generalized k-core pruning process as a simple failure procedure based on both the in- and out-degrees of nodes, in which any node with an in-degree {$<$} or an out-degree {$<$} is removed iteratively. With an explicitly analytical framework, we can predict the relative sizes of residual node clusters on uncorrelated directed random graphs. We show that the discontinuous transitions rise for cases with or , and the unidirectional interactions among nodes drive the networks more vulnerable against perturbations based on in- and out-degrees separately.},
  langid = {english},
  keywords = {readme},
  file = {/home/alpaca/GDrive/Zotero/Zhao_2017_Generalized$-less$i$-greater$k$-less$-i$-greater$-core pruning process on.pdf}
