@article{liuMappingSinglecellresolutionCell2021,
  title = {Mapping Single-Cell-Resolution Cell Phylogeny Reveals Cell Population Dynamics during Organ Development},
  author = {Liu, Kehui and Deng, Shanjun and Ye, Chang and Yao, Zeqi and Wang, Jianguo and Gong, Han and Liu, Li and He, Xionglei},
  date = {2021-12},
  journaltitle = {Nature Methods},
