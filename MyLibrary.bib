@article{aaltoGeneRegulatoryNetwork2020,
  title = {Gene Regulatory Network Inference from Sparsely Sampled Noisy Data},
  author = {Aalto, Atte and Viitasaari, Lauri and Ilmonen, Pauliina and Mombaerts, Laurent and Gonçalves, Jorge},
  date = {2020-07-13},
  journaltitle = {Nature Communications},
