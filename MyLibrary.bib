@article{stassenGeneralizedScalableTrajectory2021,
  title = {Generalized and Scalable Trajectory Inference in Single-Cell Omics Data with {{VIA}}},
  author = {Stassen, Shobana V. and Yip, Gwinky G. K. and Wong, Kenneth K. Y. and Ho, Joshua W. K. and Tsia, Kevin K.},
  date = {2021-09-20},
  journaltitle = {Nature Communications},
