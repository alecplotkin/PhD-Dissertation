@article{martinIntegrativeAnalysisSuggests2020,
  title = {Integrative Analysis Suggests Cell Type–Specific Decoding of {{NF-κB}} Dynamics},
  author = {Martin, Erik W. and Pacholewska, Alicja and Patel, Heta and Dashora, Himanshu and Sung, Myong-Hee},
  date = {2020-02-25},
  journaltitle = {Science Signaling},
