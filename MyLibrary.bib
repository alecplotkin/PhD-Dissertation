  keywords = {Clustered Regularly Interspaced Short Palindromic Repeats,CRISPR,CRISPR-Associated Protein 9,CRISPR-Cas Systems,Gene Knockout Techniques,Genome Human,Genome-Wide Association Study,genome-wide pooled screens,Humans,immunotherapy,primary human T cells,single-cell RNA-seq,T cell activation,T cell proliferation,T-Lymphocytes},
