}

@article{byrneBistabilityRac1PAK2016,
  title = {Bistability in the {{Rac1}}, {{PAK}}, and {{RhoA Signaling Network Drives Actin Cytoskeleton Dynamics}} and {{Cell Motility Switches}}},
  author = {Byrne, Kate~M. and Monsefi, Naser and Dawson, John~C. and Degasperi, Andrea and Bukowski-Wills, Jimi-Carlo and Volinsky, Natalia and Dobrzyński, Maciej and Birtwistle, Marc~R. and Tsyganov, Mikhail~A. and Kiyatkin, Anatoly and Kida, Katarzyna and Finch, Andrew~J. and Carragher, Neil~O. and Kolch, Walter and Nguyen, Lan~K. and {von~Kriegsheim}, Alex and Kholodenko, Boris~N.},
  date = {2016-01},
