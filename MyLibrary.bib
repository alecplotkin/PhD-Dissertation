@article{zhangOptimalTransportAnalysis2021,
  title = {Optimal Transport Analysis Reveals Trajectories in Steady-State Systems},
  author = {Zhang, Stephen and Afanassiev, Anton and Greenstreet, Laura and Matsumoto, Tetsuya and Schiebinger, Geoffrey},
  date = {2021-12-03},
  journaltitle = {PLOS Computational Biology},
  shortjournal = {PLOS Computational Biology},
  volume = {17},
  number = {12},
  pages = {e1009466},
  publisher = {Public Library of Science},
  issn = {1553-7358},
  doi = {10.1371/journal.pcbi.1009466},
  url = {https://journals.plos.org/ploscompbiol/article?id=10.1371/journal.pcbi.1009466},
  urldate = {2023-02-14},
  abstract = {Understanding how cells change their identity and behaviour in living systems is an important question in many fields of biology. The problem of inferring cell trajectories from single-cell measurements has been a major topic in the single-cell analysis community, with different methods developed for equilibrium and non-equilibrium systems (e.g. haematopoeisis vs. embryonic development). We show that optimal transport analysis, a technique originally designed for analysing time-courses, may also be applied to infer cellular trajectories from a single snapshot of a population in equilibrium. Therefore, optimal transport provides a unified approach to inferring trajectories that is applicable to both stationary and non-stationary systems. Our method, StationaryOT, is mathematically motivated in a natural way from the hypothesis of a Waddington’s epigenetic landscape. We implement StationaryOT as a software package and demonstrate its efficacy in applications to simulated data as well as single-cell data from Arabidopsis thaliana root development.},
  langid = {english},
  keywords = {Arabidopsis thaliana,Cell cycle and cell division,Cell differentiation,Entropy,Graph theory,Meristems,Solute transport,Transcriptome analysis},
  file = {/home/alpaca/GDrive/Zotero/Zhang et al_2021_Optimal transport analysis reveals trajectories in steady-state systems2.pdf}
}

