@online{jiOptimalDistanceMetrics2023,
  title = {Optimal Distance Metrics for Single-Cell {{RNA-seq}} Populations},
  author = {Ji, Yuge and Green, Tessa D. and Peidli, Stefan and Bahrami, Mojtaba and Liu, Meiqi and Zappia, Luke and Hrovatin, Karin and Sander, Chris and Theis, Fabian J.},
  date = {2023-12-27},
  eprinttype = {bioRxiv},
