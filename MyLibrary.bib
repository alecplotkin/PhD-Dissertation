  volume = {442},
  number = {7100},
  eprint = {16855590},
  eprinttype = {pubmed},
  pages = {299--302},
  issn = {1476-4687},
  doi = {10.1038/nature04882},
  abstract = {Mammalian Kruppel-like transcription factors are implicated in regulating terminal differentiation of several tissue types. Deficiency in Kruppel-like factor (KLF) 2 (also known as LKLF) leads to a massive loss of the peripheral T-cell pool, suggesting KLF2 regulates T-cell quiescence and survival. Here we show, however, that KLF2 is essential for T-cell trafficking. KLF2-deficient (Klf2-/-) thymocytes show impaired expression of several receptors required for thymocyte emigration and peripheral trafficking, including the sphingosine-1-phosphate (S1P) receptor S1P1, CD62L and beta7 integrin. Furthermore, KLF2 both binds and transactivates the promoter for S1P1--a receptor that is critical for thymocyte egress and recirculation through peripheral lymphoid organs. Our findings suggest that KLF2 serves to license mature T cells for trafficking from the thymus and recirculation through secondary lymphoid tissues.},
  langid = {english},
  keywords = {Adoptive Transfer,Animals,Cell Line Tumor,Cell Movement,Chimera,Fetus,Humans,Jurkat Cells,Kruppel-Like Transcription Factors,Liver,Mice,Promoter Regions Genetic,Receptors Lysosphingolipid,T-Lymphocytes,Thymus Gland,Transcriptional Activation}
}

