@article{hobsonClonalCD8Cells2026,
  title = {Clonal {{CD8}}+ {{T}} Cells Populate the Leptomeninges and Coordinate with Immune Cells in Human Degenerative Brain Diseases},
  author = {Hobson, Ryan and Levy, Samuel H. S. and Singal, Chitra Mohinder Singh and Flaherty, Delaney and Xiao, Harrison and Ciener, Benjamin and Reddy, Hasini and Zabinyakov, Nick and Kim, Christine Y. and Teich, Andrew F. and Shneider, Neil A. and Bradshaw, Elizabeth M. and Elyaman, Wassim},
  date = {2026-02},
  journaltitle = {Nature Immunology},
  shortjournal = {Nat Immunol},
  volume = {27},
  number = {2},
  pages = {323--335},
  publisher = {Nature Publishing Group},
  issn = {1529-2916},
  doi = {10.1038/s41590-025-02401-6},
  url = {https://www.nature.com/articles/s41590-025-02401-6},
  urldate = {2026-02-18},
  abstract = {Meningeal immune cells monitor the central nervous system (CNS) and influence neuroinflammation in mice, but the human leptomeningeal immune landscape and the changes that occur in this immunological niche in neurodegeneration remain underexplored. Here we performed single-cell RNA and T\,cell receptor (TCR) sequencing of 99,625 high-quality immune cells from 57 leptomeninges and brain samples from donors with Alzheimer’s disease (AD), amyotrophic lateral sclerosis and Parkinson’s disease and found that although the leptomeninges are home to highly clonally expanded CD8 tissue-resident memory (TRM) T\,cells, the maximal level of clonal expansion was decreased in AD in comparison to non-neurodegenerative controls. Intra-patient paired tissue analysis further revealed that brain and leptomeningeal TCR repertoires share significant similarities, but tissue-specific clones emerge in AD. Finally, in AD, the degree of CD8 TRM clonal expansion was positively correlated with microglial TGFB2, suggesting that brain and leptomeningeal immune cells coordinate their activities in AD. In addition to identifying key inflammatory dynamics in the human degenerating CNS, this study establishes a foundational resource for future studies that could inform treatment for AD and other neuroinflammatory diseases.},
  langid = {english},
  keywords = {Immunological surveillance,Neuroimmunology},
  file = {/home/alpaca/GDrive/Zotero/Hobson et al. - 2026 - Clonal CD8+ T cells populate the leptomeninges and coordinate with immune cells in human degenerativ.pdf}
}

@article{hockemeyerStressResponseRegulator2024,
  title = {The Stress Response Regulator {{HSF1}} Modulates Natural Killer Cell Anti-Tumour Immunity},
  author = {Hockemeyer, Kathryn and Sakellaropoulos, Theodore and Chen, Xufeng and Ivashkiv, Olha and Sirenko, Maria and Zhou, Hua and Gambi, Giovanni and Battistello, Elena and Avrampou, Kleopatra and Sun, Zhengxi and Guillamot, Maria and Chiriboga, Luis and Jour, George and Dolgalev, Igor and Corrigan, Kate and Bhatt, Kamala and Osman, Iman and Tsirigos, Aristotelis and Kourtis, Nikos and Aifantis, Iannis},
  date = {2024-09-02},
  journaltitle = {Nature Cell Biology},
  shortjournal = {Nat Cell Biol},
  pages = {1--11},
  publisher = {Nature Publishing Group},
  issn = {1476-4679},
  doi = {10.1038/s41556-024-01490-z},
  url = {https://www.nature.com/articles/s41556-024-01490-z},
  urldate = {2024-10-07},
  abstract = {Diverse cellular insults converge on activation of the heat shock factor 1 (HSF1), which regulates the proteotoxic stress response to maintain protein homoeostasis. HSF1 regulates numerous gene programmes beyond the proteotoxic stress response in a cell-type- and context-specific manner to promote malignancy. However, the role(s) of HSF1 in immune populations of the tumour microenvironment remain elusive. Here, we leverage an in vivo model of HSF1 activation and single-cell transcriptomic tumour profiling to show that augmented HSF1 activity in natural killer (NK) cells impairs cytotoxicity, cytokine production and subsequent anti-tumour immunity. Mechanistically, HSF1 directly binds and regulates the expression of key mediators of NK cell effector function. This work demonstrates that HSF1 regulates the immune response under the stress conditions of the tumour microenvironment. These findings have important implications for enhancing the efficacy of adoptive NK cell therapies and for designing combinatorial strategies including modulators of NK cell-mediated tumour killing.},
  langid = {english},
  keywords = {Immunosurveillance,Stress signalling,Tumour immunology},
  file = {/home/alpaca/GDrive/Zotero/Hockemeyer et al_2024_The stress response regulator HSF1 modulates natural killer cell anti-tumour.pdf}
}

