@article{chenBATFRegulatesProgenitor2021,
  title = {{{BATF}} Regulates Progenitor to Cytolytic Effector {{CD8}}+ {{T}} Cell Transition during Chronic Viral Infection},
  author = {Chen, Yao and Zander, Ryan A. and Wu, Xiaopeng and Schauder, David M. and Kasmani, Moujtaba Y. and Shen, Jian and Zheng, Shikan and Burns, Robert and Taparowsky, Elizabeth J. and Cui, Weiguo},
  date = {2021-08},
  journaltitle = {Nature Immunology},
