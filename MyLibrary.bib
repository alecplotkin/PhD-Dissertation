@article{heCD8CellsUtilize2016,
  title = {{{CD8}}+ {{T Cells Utilize Highly Dynamic Enhancer Repertoires}} and {{Regulatory Circuitry}} in {{Response}} to {{Infections}}},
  author = {He, Bing and Xing, Shaojun and Chen, Changya and Gao, Peng and Teng, Li and Shan, Qiang and Gullicksrud, Jodi A. and Martin, Matthew D. and Yu, Shuyang and Harty, John T. and Badovinac, Vladimir P. and Tan, Kai and Xue, Hai-Hui},
  date = {2016-12-20},
  journaltitle = {Immunity},
  shortjournal = {Immunity},
