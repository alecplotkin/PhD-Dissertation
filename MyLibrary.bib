  keywords = {antigen-presenting cells,cancer,CD8 T cells,co-stimulation,T cell differentiation,T cell exhaustion,tumor-draining lymph nodes,tumor-infiltrating lymphocytes},
  file = {/home/alpaca/GDrive/Zotero/Prokhnevska et al_2023_CD8+ T cell activation in cancer comprises an initial activation phase in lymph.pdf;/home/alpaca/Zotero/storage/4TEUPYY4/S1074761322006069.html}
