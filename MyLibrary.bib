  author = {Connolly, Kelli A. and Kuchroo, Manik and Venkat, Aarthi and Khatun, Achia and Wang, Jiawei and William, Ivana and Hornick, Noah and Fitzgerald, Brittany and Damo, Martina and Kasmani, Moujtaba Y. and Cui, Can and Fagerberg, Eric and Monroy, Isabel and Hutchins, Amanda and Cheung, Julie F. and Foster, Gena G. and Mariuzza, Dylan L. and Nader, Mursal and Zhao, Hongyu and Cui, Weiguo and Krishnaswamy, Smita and Joshi, Nikhil S.},
  date = {2021-10},
  journaltitle = {Science immunology},
  shortjournal = {Sci Immunol},
