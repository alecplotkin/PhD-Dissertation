@article{vanderleunCD8CellStates2020,
  title = {{{CD8}}+ {{T}} Cell States in Human Cancer: Insights from Single-Cell Analysis},
  shorttitle = {{{CD8}}+ {{T}} Cell States in Human Cancer},
  author = {family=Leun, given=Anne M., prefix=van der, useprefix=true and Thommen, Daniela S. and Schumacher, Ton N.},
  date = {2020-04},
  journaltitle = {Nature Reviews Cancer},
