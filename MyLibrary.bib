@article{gerlachHeterogeneousDifferentiationPatterns2013,
  title = {Heterogeneous {{Differentiation Patterns}} of {{Individual CD8}}+ {{T Cells}}},
  author = {Gerlach, Carmen and Rohr, Jan C. and Perié, Leïla and family=Rooij, given=Nienke, prefix=van, useprefix=true and family=Heijst, given=Jeroen W. J., prefix=van, useprefix=true and Velds, Arno and Urbanus, Jos and Naik, Shalin H. and Jacobs, Heinz and Beltman, Joost B. and family=Boer, given=Rob J., prefix=de, useprefix=true and Schumacher, Ton N. M.},
