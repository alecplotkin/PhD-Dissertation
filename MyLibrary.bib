@article{chouTranscriptionFactorAP42016,
  title = {The {{Transcription Factor AP4 Mediates Resolution}} of {{Chronic Viral Infection}} through {{Amplification}} of {{Germinal Center B Cell Responses}}},
  author = {Chou, Chun and Verbaro, Daniel J. and Tonc, Elena and Holmgren, Melanie and Cella, Marina and Colonna, Marco and Bhattacharya, Deepta and Egawa, Takeshi},
  date = {2016-09-20},
