  title = {Transcriptional Profiles Reveal a Stepwise Developmental Program of Memory {{CD8}}+ {{T}} Cell Differentiation},
  author = {Roychoudhuri, Rahul and Lefebvre, Francois and Honda, Mitsuo and Pan, Li and Ji, Yun and Klebanoff, Christopher A. and Nichols, Carmen N. and Fourati, Slim and Hegazy, Ahmed N. and Goulet, Jean-Philippe and Gattinoni, Luca and Nabel, Gary J. and Gilliet, Michel and Cameron, Mark and Restifo, Nicholas P. and Sékaly, Rafick P. and Flatz, Lukas},
  date = {2015-02-11},
