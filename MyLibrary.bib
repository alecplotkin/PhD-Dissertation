@article{prokhnevskaCD8CellActivation2023,
  title = {{{CD8}}+ {{T}}~Cell Activation in Cancer Comprises an Initial Activation Phase in Lymph Nodes Followed by Effector Differentiation within the Tumor},
  author = {Prokhnevska, Nataliya and Cardenas, Maria A. and Valanparambil, Rajesh M. and Sobierajska, Ewelina and Barwick, Benjamin G. and Jansen, Caroline and Reyes Moon, Adriana and Gregorova, Petra and {delBalzo}, Luke and Greenwald, Rachel and Bilen, Mehmet Asim and Alemozaffar, Mehrdad and Joshi, Shreyas and Cimmino, Cara and Larsen, Christian and Master, Viraj and Sanda, Martin and Kissick, Haydn},
