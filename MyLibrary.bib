@article{kamimotoGeneRegulatoryNetwork2023a,
  title = {Gene Regulatory Network Reconfiguration in Direct Lineage Reprogramming},
  author = {Kamimoto, Kenji and Adil, Mohd Tayyab and Jindal, Kunal and Hoffmann, Christy M. and Kong, Wenjun and Yang, Xue and Morris, Samantha A.},
  date = {2023-01-10},
  journaltitle = {Stem Cell Reports},
  shortjournal = {Stem Cell Reports},
  volume = {18},
  number = {1},
  eprint = {36584685},
  eprinttype = {pubmed},
  pages = {97--112},
  issn = {2213-6711},
  doi = {10.1016/j.stemcr.2022.11.010},
  abstract = {In direct lineage conversion, transcription factor (TF) overexpression reconfigures gene regulatory networks (GRNs) to reprogram cell identity. We previously developed CellOracle, a computational method to infer GRNs from single-cell transcriptome and epigenome data. Using inferred GRNs, CellOracle simulates gene expression changes in response to TF perturbation, enabling in silico interrogation of network reconfiguration. Here, we combine CellOracle analysis with lineage tracing of fibroblast to induced endoderm progenitor (iEP) conversion, a prototypical direct reprogramming paradigm. By linking early network state to reprogramming outcome, we reveal distinct network configurations underlying successful and failed fate conversion. Via in silico simulation of TF perturbation, we identify new factors to coax cells into successfully converting their identity, uncovering a central role for the AP-1 subunit Fos with the Hippo signaling effector, Yap1. Together, these results demonstrate the efficacy of CellOracle to infer and interpret cell-type-specific GRN configurations, providing new mechanistic insights into lineage reprogramming.},
  langid = {english},
  pmcid = {PMC9860067},
  keywords = {cell fate prediction,Cellular Reprogramming,direct lineage reprogramming,Fibroblasts,Gene Expression Regulation,gene perturbation simulation,gene regulatory networks,Gene Regulatory Networks,machine learning,single-cell analysis,Transcription Factors,Transcriptome},
  file = {/home/alpaca/GDrive/Zotero/Kamimoto et al_2023_Gene regulatory network reconfiguration in direct lineage reprogramming.pdf}
}

@article{kanbarLongNoncodingRNA2022,
  title = {The Long Noncoding {{RNA Malat1}} Regulates {{CD8}}+ {{T}} Cell Differentiation by Mediating Epigenetic Repression},
  author = {Kanbar, Jad N. and Ma, Shengyun and Kim, Eleanor S. and Kurd, Nadia S. and Tsai, Matthew S. and Tysl, Tiffani and Widjaja, Christella E. and Limary, Abigail E. and Yee, Brian and He, Zhaoren and Hao, Yajing and Fu, Xiang-Dong and Yeo, Gene W. and Huang, Wendy J. and Chang, John T.},
  date = {2022-05-20},
  journaltitle = {Journal of Experimental Medicine},
  shortjournal = {Journal of Experimental Medicine},
  volume = {219},
  number = {6},
  pages = {e20211756},
  issn = {0022-1007},
  doi = {10.1084/jem.20211756},
  url = {https://doi.org/10.1084/jem.20211756},
  urldate = {2024-05-15},
  abstract = {During an immune response to microbial infection, CD8+ T cells give rise to short-lived effector cells and memory cells that provide sustained protection. Although the transcriptional programs regulating CD8+ T cell differentiation have been extensively characterized, the role of long noncoding RNAs (lncRNAs) in this process remains poorly understood. Using a functional genetic knockdown screen, we identified the lncRNA Malat1 as a regulator of terminal effector cells and the terminal effector memory (t-TEM) circulating memory subset. Evaluation of chromatin-enriched lncRNAs revealed that Malat1 grouped with trans lncRNAs that exhibit increased RNA interactions at gene promoters and gene bodies. Moreover, we observed that Malat1 was associated with increased H3K27me3 deposition at a number of memory cell-associated genes through a direct interaction with Ezh2, thereby promoting terminal effector and t-TEM cell differentiation. Our findings suggest an important functional role of Malat1 in regulating CD8+ T cell differentiation and broaden the knowledge base of lncRNAs in CD8+ T cell biology.},
  file = {/home/alpaca/GDrive/Zotero/Kanbar et al_2022_The long noncoding RNA Malat1 regulates CD8+ T cell differentiation by.pdf;/home/alpaca/Zotero/storage/MZBY6DUB/The-long-noncoding-RNA-Malat1-regulates-CD8-T-cell.html}
}

@article{karimiOrderLogicCD42021,
  title = {The Order and Logic of {{CD4}} versus {{CD8}} Lineage Choice and Differentiation in Mouse Thymus},
  author = {Karimi, Mohammad M. and Guo, Ya and Cui, Xiaokai and Pallikonda, Husayn A. and Horková, Veronika and Wang, Yi-Fang and Gil, Sara Ruiz and Rodriguez-Esteban, Gustavo and Robles-Rebollo, Irene and Bruno, Ludovica and Georgieva, Radina and Patel, Bhavik and Elliott, James and Dore, Marian H. and Dauphars, Danielle and Krangel, Michael S. and Lenhard, Boris and Heyn, Holger and Fisher, Amanda G. and Štěpánek, Ondřej and Merkenschlager, Matthias},
  date = {2021-01-04},
  journaltitle = {Nature Communications},
  shortjournal = {Nat Commun},
  volume = {12},
  number = {1},
  pages = {99},
  publisher = {Nature Publishing Group},
  issn = {2041-1723},
  doi = {10.1038/s41467-020-20306-w},
  url = {https://www.nature.com/articles/s41467-020-20306-w},
  urldate = {2022-08-17},
  abstract = {CD4 and CD8 mark helper and cytotoxic T cell lineages, respectively, and serve as coreceptors for MHC-restricted TCR recognition. How coreceptor expression is matched with TCR specificity is central to understanding CD4/CD8 lineage choice, but visualising coreceptor gene activity in individual selection intermediates has been technically challenging. It therefore remains unclear whether the sequence of coreceptor gene expression in selection intermediates follows a stereotypic pattern, or is responsive to signaling. Here we use single cell RNA sequencing (scRNA-seq) to classify mouse thymocyte selection intermediates by coreceptor gene expression. In the unperturbed thymus, Cd4+Cd8a- selection intermediates appear before Cd4-Cd8a+ selection intermediates, but the timing of these subsets is flexible according to the strength of TCR signals. Our data show that selection intermediates discriminate MHC class prior to the loss of coreceptor expression and suggest a model where signal strength informs the timing of coreceptor gene activity and ultimately CD4/CD8 lineage choice.},
  issue = {1},
  langid = {english},
  keywords = {Gene regulation in immune cells,Haematopoiesis,Lymphocyte differentiation,readme,Signal transduction},
  file = {/home/alpaca/GDrive/Zotero/Karimi et al_2021_The order and logic of CD4 versus CD8 lineage choice and differentiation in.pdf;/home/alpaca/Zotero/storage/3AJJRGAS/s41467-020-20306-w.html}
}

@article{kasmaniClonalLineageTracing2023,
  title = {Clonal Lineage Tracing Reveals Mechanisms Skewing {{CD8}}+ {{T}} Cell Fate Decisions in Chronic Infection},
  author = {Kasmani, Moujtaba Y. and Zander, Ryan and Chung, H. Kay and Chen, Yao and Khatun, Achia and Damo, Martina and Topchyan, Paytsar and Johnson, Kaitlin E. and Levashova, Darya and Burns, Robert and Lorenz, Ulrike M. and Tarakanova, Vera L. and Joshi, Nikhil S. and Kaech, Susan M. and Cui, Weiguo},
  date = {2023-01-02},
  journaltitle = {Journal of Experimental Medicine},
  volume = {220},
  number = {1},
  pages = {e20220679},
  issn = {0022-1007, 1540-9538},
  doi = {10.1084/jem.20220679},
  url = {https://rupress.org/jem/article/220/1/e20220679/213624/Clonal-lineage-tracing-reveals-mechanisms-skewing},
  urldate = {2023-03-29},
  abstract = {Although recent evidence demonstrates heterogeneity among CD8+ T cells during chronic infection, developmental relationships and mechanisms underlying their fate decisions remain incompletely understood. Using single-cell RNA and TCR sequencing, we traced the clonal expansion and differentiation of CD8+ T cells during chronic LCMV infection. We identified immense clonal and phenotypic diversity, including a subset termed intermediate cells. Trajectory analyses and infection models showed intermediate cells arise from progenitor cells before bifurcating into terminal effector and exhausted subsets. Genetic ablation experiments identified that type I IFN drives exhaustion through an IRF7-dependent mechanism, possibly through an IFN-stimulated subset bridging progenitor and exhausted cells. Conversely, Zeb2 was critical for generating effector cells. Intriguingly, some T cell clones exhibited lineage bias. Mechanistically, we identified that TCR avidity correlates with an exhausted fate, whereas SHP-1 selectively restricts low-avidity effector cell accumulation. Thus, our work elucidates novel mechanisms underlying CD8+ T cell fate determination during persistent infection and suggests two potential pathways leading to exhaustion.},
  langid = {english},
  keywords = {read},
  file = {/home/alpaca/GDrive/Zotero/Kasmani et al_2023_Clonal lineage tracing reveals mechanisms skewing CD8+ T cell fate decisions in.pdf}
}

