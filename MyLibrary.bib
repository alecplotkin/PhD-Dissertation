  langid = {english},
  keywords = {CD8 tissue-resident memory T cell,GP33,heterogeneity,LCMV infection,single-cell RNA-sequencing,transcription factors,transcriptional regulation},
  file = {/home/alpaca/GDrive/Zotero/Chen et al_2021_Single-Cell Transcriptomics Reveals Core Regulatory Programs That Determine the.pdf}
}

