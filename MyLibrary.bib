@article{friedrichApproachingComplexityStochastic2011,
  title = {Approaching Complexity by Stochastic Methods: {{From}} Biological Systems to Turbulence},
  shorttitle = {Approaching Complexity by Stochastic Methods},
  author = {Friedrich, Rudolf and Peinke, Joachim and Sahimi, Muhammad and Reza Rahimi Tabar, M.},
  date = {2011-09-01},
  journaltitle = {Physics Reports},
  shortjournal = {Physics Reports},
  volume = {506},
  number = {5},
  pages = {87--162},
  issn = {0370-1573},
  doi = {10.1016/j.physrep.2011.05.003},
  url = {https://www.sciencedirect.com/science/article/pii/S0370157311001530},
  urldate = {2023-05-04},
  abstract = {This review addresses a central question in the field of complex systems: given a fluctuating (in time or space), sequentially measured set of experimental data, how should one analyze the data, assess their underlying trends, and discover the characteristics of the fluctuations that generate the experimental traces? In recent years, significant progress has been made in addressing this question for a class of stochastic processes that can be modeled by Langevin equations, including additive as well as multiplicative fluctuations or noise. Important results have emerged from the analysis of temporal data for such diverse fields as neuroscience, cardiology, finance, economy, surface science, turbulence, seismic time series and epileptic brain dynamics, to name but a few. Furthermore, it has been recognized that a similar approach can be applied to the data that depend on a length scale, such as velocity increments in fully developed turbulent flow, or height increments that characterize rough surfaces. A basic ingredient of the approach to the analysis of fluctuating data is the presence of a Markovian property, which can be detected in real systems above a certain time or length scale. This scale is referred to as the Markov–Einstein (ME) scale, and has turned out to be a useful characteristic of complex systems. We provide a review of the operational methods that have been developed for analyzing stochastic data in time and scale. We address in detail the following issues: (i) reconstruction of stochastic evolution equations from data in terms of the Langevin equations or the corresponding Fokker–Planck equations and (ii) intermittency, cascades, and multiscale correlation functions.},
  langid = {english},
  keywords = {Fokker–Planck and Langevin equations,Multifractal,Stochastic processes,Time series},
  file = {/home/alpaca/GDrive/Zotero/Friedrich et al_2011_Approaching complexity by stochastic methods.pdf;/home/alpaca/Zotero/storage/T4LNKF23/S0370157311001530.html}
}

@article{frischholzMetabolicQuiescenceNaivelike2026,
  title = {Metabolic Quiescence of Naive-like Memory {{T}} Cells Precedes and Maintains Antigen-Specific {{T}} Cell Memory},
  author = {Frischholz, Sina and Schuster, Ev-Marie and Grotz, Myriam and Schülein, Christine and Benz, Julia and Kocher, Katharina and Klotz, Lucia and Varga, Szilard and Hiltner, Theresa and Alsalameh, Rayya and Esse, Jan and Träger, Johannes and Held, Jürgen and Graw, Frederik and Pahle, Jürgen and Spriewald, Bernd and Gattinoni, Luca and Buchholz, Veit R. and Drost, Felix and Schubert, Benjamin and Rothenfußer, Simon and Busch, Dirk H. and Bogdan, Christian and Schober, Kilian},
  date = {2026-03},
  journaltitle = {Nature Immunology},
  shortjournal = {Nat Immunol},
  volume = {27},
  number = {3},
  pages = {452--462},
  publisher = {Nature Publishing Group},
  issn = {1529-2916},
  doi = {10.1038/s41590-026-02421-w},
  url = {https://www.nature.com/articles/s41590-026-02421-w},
  urldate = {2026-03-17},
  abstract = {Metabolic activity shapes cell fate but remains challenging to capture in vivo with high resolution. Here we performed longitudinal metabolic and phenotypic profiling of human antigen-specific CD8+ T cells after yellow fever vaccination using flow cytometry and single-cell RNA sequencing. As assessed by protein translation rates, CD8+ T cells upregulated glycolysis to fuel anabolic needs for proliferation but predominantly used oxidative phosphorylation for energy production during the acute phase (days 7–28) after vaccination. Simultaneously, CD8+CD62L+CD45RA− central memory T cells were the most metabolically active subset, whereas CD8+CD62L−CD45RA+ effector T cells underwent metabolic shutdown. Weakly differentiated CD8+CD62L+CD45RA+CD95− naive-like memory T cells showed minimal activity, relied solely on oxidative phosphorylation and were preferentially maintained 26 years postvaccination, reinforcing the link between cellular quiescence and longevity. Our study highlights quiescence as a key feature for long-term immunological memory formation in humans.},
  langid = {english},
  keywords = {Immunological memory,T cells,Viral infection},
  file = {/home/alpaca/GDrive/Zotero/Frischholz et al. - 2026 - Metabolic quiescence of naive-like memory T cells precedes and maintains antigen-specific T cell mem.pdf}
}

@article{furmanSituFunctionalCell2021,
  title = {In Situ Functional Cell Phenotyping Reveals Microdomain Networks in Colorectal Cancer Recurrence},
